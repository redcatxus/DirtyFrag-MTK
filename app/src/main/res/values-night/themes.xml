<resources>
    <style name="Base.Theme.DirtyFrag" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Dark fallback palette for Android < 12 / non-Material You devices -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/secondary_ink</item>
        <item name="colorOutlineVariant">@color/card_outline</item>
        <item name="android:colorBackground">@color/page_background</item>
        <!-- Dark mode: icons should be light on dark bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
