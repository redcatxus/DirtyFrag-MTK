<resources>
    <style name="Base.Theme.DirtyFrag" parent="Theme.Material3.Light.NoActionBar">
        <!-- Fallback palette for Android < 12 / non-Material You devices -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/secondary_ink</item>
        <item name="colorOutlineVariant">@color/card_outline</item>
        <item name="android:colorBackground">@color/page_background</item>
        <!-- Let the system draw status/nav bar icons in the right color -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.DirtyFrag" parent="Base.Theme.DirtyFrag" />
    <style name="Widget.DirtyFrag.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_active_indicator</item>
    </style>
</resources>
